NODE_ENV=development
PORT=3000
APP_NOME="HK Nippon store"
LOJA_HERO_ETIQUETA="Importados do Japao"
LOJA_HERO_TITULO="Doces, presentes e achadinhos japoneses"
LOJA_HERO_DESCRICAO="Produtos selecionados para montar seu pedido com calma e finalizar em uma tela separada."
LOJA_HERO_IMAGEM_URL="/loja/assets/hero-produtos-japao.png"
LOJA_COR_PRINCIPAL="#c52233"
LOJA_COR_PRINCIPAL_ESCURO="#8e1724"
LOJA_ATENDIMENTO_TEXTO="Atendimento pelo WhatsApp apos a confirmacao do pedido."
POSTGRES_PORT=5432
DATABASE_URL="postgresql://loja_japao:loja_japao@localhost:5432/loja_japao_bot?schema=public"
UPLOADS_DIR="public/uploads"
# Dados exibidos ao cliente para transferencia Pix manual. Preencha no .env local.
PIX_CHAVE="sua-chave-pix"
PIX_RECEBEDOR="Nome do recebedor"
# Frete Brasil -> Brasil. Token privado; nunca colocar no frontend nem no Git.
FRETE_CEP_ORIGEM="00000000"
MELHOR_ENVIO_AMBIENTE="sandbox"
MELHOR_ENVIO_TOKEN="cole-seu-token-sandbox-aqui"
MELHOR_ENVIO_CONTATO="seu-email@example.com"
TRUST_PROXY=false
LOG_REQUESTS=true
PUBLIC_WRITE_MAX_REQUISICOES=30
PUBLIC_WRITE_JANELA_MINUTOS=10
PUBLIC_TRACKING_MAX_CONSULTAS=60
PUBLIC_TRACKING_JANELA_MINUTOS=10
ADMIN_LOGIN_MAX_TENTATIVAS=5
ADMIN_LOGIN_BLOQUEIO_MINUTOS=15
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="troque-esta-senha"
AUTH_TOKEN_SECRET="gere-um-segredo-com-npm-run-gerar-segredo"

# Recuperacao de senha automatica. Deixe todos vazios ate configurar o e-mail.
# APP_URL_PUBLICA: origem da loja (HTTPS em producao; http://localhost:3000 em teste).
APP_URL_PUBLICA=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_REMETENTE=""

# Mercado Pago Checkout Pro / Orders: copie da aba Teste. Nunca envie para o frontend.
# Ative o checkout de teste com MERCADO_PAGO_MODO=teste.
MERCADO_PAGO_ACCESS_TOKEN=""

# Checkout Pro via Orders: teste local apenas; producao bloqueada nesta etapa.
MERCADO_PAGO_MODO="desativado"
# Origem HTTPS temporaria para retorno (opcional para abrir checkout sem retorno automatico).
MERCADO_PAGO_URL_RETORNO=""
# Assinatura da configuracao de Webhooks / Teste; nao e o Access Token.
MERCADO_PAGO_WEBHOOK_SECRET=""
