{
  "name": "loja-japao-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "check": "tsc --noEmit",
    "test:pedidos": "node --import tsx --test tests/pedidos-listagem.test.mjs",
    "test:consistencia": "node scripts/test-consistencia.mjs",
    "gerar:segredo": "node scripts/gerar-segredo.mjs",
    "verificar:build": "node scripts/verificar-build.mjs",
    "verificar:deploy": "node scripts/verificar-deploy.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "node scripts/seed.mjs",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "test:checkout": "node --test tests/checkout-frete.test.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verificar": "node scripts/backup.mjs --verificar",
    "verificar:mercadopago": "node scripts/verificar-mercado-pago.mjs",
    "tunel:mercadopago": "node scripts/tunel-mercado-pago.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "^5.2.1",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.0"
  },
  "overrides": {
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma@7.10.0": {
      "mysql2": "3.24.6"
    }
  }
}
