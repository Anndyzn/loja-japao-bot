{
  "name": "loja-japao-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "check": "tsc --noEmit",
    "gerar:segredo": "node scripts/gerar-segredo.mjs",
    "verificar:build": "node scripts/verificar-build.mjs",
    "verificar:deploy": "node scripts/verificar-deploy.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npx --yes prisma@7.10.0 generate",
    "db:migrate": "npx --yes prisma@7.10.0 migrate dev",
    "db:deploy": "npx --yes prisma@7.10.0 migrate deploy",
    "db:seed": "node scripts/seed.mjs",
    "db:studio": "npx --yes prisma@7.10.0 studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
